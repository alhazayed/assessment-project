# Local development env for V Welfare — copy to .env.local:  cp env.local.sample .env.local
# All values here are LOCAL, non-secret defaults (local Supabase demo keys,
# Cloudflare Turnstile test keys, a throwaway admin PIN). Never use in production.

# Browser Supabase client points at the same-origin dev proxy (port 3000), which
# forwards /auth/v1, /rest/v1, /realtime/v1, /storage/v1 to local Supabase. This
# keeps requests same-origin so the app's strict CSP (connect-src 'self') is
# satisfied without editing middleware.ts. See scripts/dev-proxy.mjs.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
# Standard Supabase local demo keys (printed by `supabase start`; well-known, not secret).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Admin console (local-only values; not secrets)
ADMIN_PIN=123456
ADMIN_SESSION_SECRET=local-dev-admin-session-secret-32chars-minimum

# Site URL for local dev (must be the proxy origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

LOG_LEVEL=debug
NEXT_PUBLIC_PUSH_ENABLED=false

# Cloudflare Turnstile — official "always passes" TEST keys for local dev.
# Public, documented dummy keys: they render a real widget and make siteverify
# succeed so the login/register CAPTCHA path works locally.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
